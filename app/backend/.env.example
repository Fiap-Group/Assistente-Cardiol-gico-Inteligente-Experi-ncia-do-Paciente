# Escolha UMA opção de LLM (defina só a chave correspondente):
# - Gemini é gratuito (sem cartão) — gere a chave em https://aistudio.google.com/apikey
# - Anthropic/OpenAI são pagos (créditos pré-pagos)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opcional — sobrescreve os padrões de rag_system.py
LLM_BACKEND=gemini
LLM_MODEL=
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=
RAG_TOP_K=5
RAG_MIN_SCORE=0.25

FLASK_ENV=development
PORT=5000
