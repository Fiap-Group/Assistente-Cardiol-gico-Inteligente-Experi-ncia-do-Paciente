# Credenciais do Watson Assistant (IBM Cloud). Sem elas preenchidas, a API
# sobe automaticamente em modo simulado (mock) — ver watson_client.py.
WATSON_API_KEY=
WATSON_URL=
WATSON_ASSISTANT_ID=
WATSON_VERSION=2021-11-27

# Força o modo simulado mesmo com credenciais preenchidas (útil pra testar
# o app/backend sem consumir chamadas reais do Watson).
WATSON_MOCK=false

FLASK_ENV=development
PORT=5000
